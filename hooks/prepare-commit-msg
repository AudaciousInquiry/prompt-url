#!/bin/sh
# prepare-commit-msg git hook
#
# Automatically appends a "Prompt-URL:" trailer to commits initiated by an
# AI coding agent. Supports two agents, detected via environment variables
# the agent's CLI sets in the environment of subprocesses it launches:
#
#   GitHub Copilot CLI:  COPILOT_CLI, COPILOT_AGENT_SESSION_ID
#   Claude Code:          CLAUDECODE, CLAUDE_CODE_SESSION_ID
#
# If neither is set (i.e. this is a human-authored commit, or a commit from
# an agent this hook does not recognize), the hook exits immediately without
# modifying the commit message.
#
# Installation (run once per repository):
#
#   cp hooks/prepare-commit-msg .git/hooks/prepare-commit-msg
#   chmod +x .git/hooks/prepare-commit-msg
#
# Or install globally for all repositories via a global hooks directory
# (recommended location: ~/.git-hooks/):
#
#   git config --global core.hooksPath ~/.git-hooks
#   mkdir -p ~/.git-hooks
#   cp hooks/prepare-commit-msg ~/.git-hooks/prepare-commit-msg
#   chmod +x ~/.git-hooks/prepare-commit-msg
#
# On Windows use Git Bash or WSL to run chmod, or copy via File Explorer
# (Git for Windows treats the file as executable by default).

commit_msg_file="$1"

# Determine agent + session ID. Checked in this order so that a commit run
# by Copilot CLI acting as a subprocess of Claude Code (or vice versa) is
# still attributed to the directly-invoking agent.
if [ -n "$COPILOT_CLI" ]; then
  agent="github-copilot"
  session_id="$COPILOT_AGENT_SESSION_ID"
elif [ "$CLAUDECODE" = "1" ]; then
  agent="claude-code"
  session_id="$CLAUDE_CODE_SESSION_ID"
else
  exit 0
fi

if [ -z "$session_id" ]; then
  exit 0
fi

if ! grep -q "^Prompt-URL:" "$commit_msg_file"; then
  timestamp=$(date -u +"%Y-%m-%dT%H:%M:%S.%3NZ")
  printf "\nPrompt-URL: prompt:/%s/%s/%s\n" "$agent" "$session_id" "$timestamp" >> "$commit_msg_file"
fi